{
  "name": "linko-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev --filter=@linko/web",
    "dev:web": "turbo run dev --filter=@linko/web",
    "dev:mobile": "turbo run dev --filter=@linko/mobile",
    "web": "pnpm run dev:web",
    "mobile": "pnpm run dev:mobile",
    "build": "turbo run build --filter=@linko/web",
    "build:web": "turbo run build --filter=@linko/web",
    "start": "pnpm --filter @linko/web start",
    "lint": "turbo run lint --filter=@linko/web",
    "lint:web": "turbo run lint --filter=@linko/web",
    "typecheck": "turbo run typecheck --filter=@linko/web",
    "typecheck:web": "turbo run typecheck --filter=@linko/web"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
